# Copy to .env and adjust. Docker Compose reads it automatically.

POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse

# hh.ru requires an identifying User-Agent. Put your own contact here.
HH_USER_AGENT=kz-jobs-pipeline/0.1 (your-email@example.com)
# Only if the hh API asks for an application token (register an app at https://dev.hh.ru)
HH_APP_TOKEN=

# Search queries are separated by semicolons
HH_QUERIES=data engineer;дата инженер;инженер данных;data scientist;machine learning;аналитик данных;python;java;devops
# How many days back to search (use 30 for the first load, 1-2 for daily runs)
HH_PERIOD_DAYS=1
HH_MAX_PAGES=5
# Where hh matches queries: empty = whole vacancy text, name = title only (returns far fewer vacancies)
HH_SEARCH_FIELD=

# Abort the load (core stays untouched) when more than this share of records is rejected
REJECT_THRESHOLD_PCT=10
